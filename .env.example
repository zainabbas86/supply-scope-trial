# =============================================================================
# Label Extraction Agent — example environment
#
# Copy to .env and fill in the secrets:   cp .env.example .env
# Then generate the app key:              php artisan key:generate
#
# This file is a SUPERSET of Laravel's stock .env.example: stock keys first,
# then the extraction-specific block at the bottom. When you scaffold Laravel
# it will write its own .env.example — overwrite it with this one rather than
# merging by hand.
#
# NOTE ON HOSTS: the defaults below point at 127.0.0.1 so the app runs natively
# via Herd. docker-compose.yml overrides DB_HOST/REDIS_HOST to the service
# names (`postgres`, `redis`) in its `environment:` block, so the same file
# works both ways and nothing is hardcoded in the image.
# =============================================================================

APP_NAME="Label Extraction Agent"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
# Host port compose publishes web on. 8080, not 80: Herd's nginx holds 80.
APP_PORT=8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# --- Logging -----------------------------------------------------------------
# `stderr` in containers: logs belong on stdout/stderr for the platform to
# collect, never in a file inside an ephemeral container.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database (PostgreSQL 17) ------------------------------------------------
# Ports are deliberately non-default so the containers don't collide with any
# Postgres/Redis already listening on this machine.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=label_extractor
DB_USERNAME=label_extractor
DB_PASSWORD=secret

# --- Session / cache / queue -------------------------------------------------
# All on Redis so the web tier is stateless and can scale horizontally.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=56379
# NOTE: must be a real value, and NEVER the literal `null`.
# Docker Compose passes `null` verbatim to `redis-server --requirepass null`
# (a real password), while PHP's dotenv converts an unquoted `null` to PHP null
# so Laravel sends no AUTH at all. The two disagree and the worker dies with
# `NOAUTH Authentication required`. Compose now fails loudly if this is unset.
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
# Queue on its own database: cache:clear FLUSHDBs the cache connection.
REDIS_QUEUE_DB=2
# MUST exceed EXTRACTION_JOB_TIMEOUT, or Redis redelivers a running job.
REDIS_QUEUE_RETRY_AFTER=180

# --- Filesystem --------------------------------------------------------------
# Env-driven from day one: the web container writes the upload and a SEPARATE
# worker container has to read it back, so container-local disk is not an
# option. `local` maps to a shared named volume in compose; switch to `s3` (or
# `gcs`) in a real deployment without touching application code.
FILESYSTEM_DISK=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Mail (unused; stock Laravel keys kept for completeness) -----------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Vite --------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# Extraction agent
# =============================================================================

# OpenAI credentials. NEVER bake these into the Dockerfile or an image layer —
# they are injected at runtime by compose / the hosting platform.
OPENAI_API_KEY=sk-proj-your-key-here

# Overridable base URL. Useful for pointing an environment at a mock server
# when verifying failure paths without spending real tokens.
OPENAI_BASE_URL=https://api.openai.com/v1

# Vision + structured-output capable model. gpt-5.5 is verified working against
# the supplied key: it reads all pages of an image-only PDF and honours a strict
# json_schema. It is a reasoning model, so expect ~15-20s per call — which is
# precisely why extraction belongs on a queue and not in the web request.
OPENAI_MODEL=gpt-5.5

# --- Extraction tuning -------------------------------------------------------
# HTTP timeouts. EXTRACTION_TIMEOUT must stay below the job timeout, which in
# turn must stay below queue retry_after, or a slow call gets double-delivered.
EXTRACTION_CONNECT_TIMEOUT=10
EXTRACTION_TIMEOUT=90

# Job-level retry budget. Retryable errors (429, 5xx, timeouts) consume these;
# terminal errors (400/401/403, invalid-after-repair) fail immediately instead.
EXTRACTION_QUEUE=extraction
EXTRACTION_MAX_TRIES=3
EXTRACTION_JOB_TIMEOUT=120

# Requests per minute allowed against the OpenAI account. The worker sheds load
# against this rather than hammering the API into 429s.
EXTRACTION_RATE_LIMIT_PER_MINUTE=60

# --- Upload limits -----------------------------------------------------------
# Cost and abuse ceilings, enforced server-side as well as in the UI.
UPLOAD_MAX_FILE_SIZE_KB=20480
UPLOAD_MAX_FILES_PER_REQUEST=20
UPLOAD_MAX_PDF_PAGES=15
# Hard ceiling on extractions per day. A leaked credential cannot run up an
# unbounded bill overnight; also half the answer to "what about 50,000 uploads".
EXTRACTION_DAILY_LIMIT=200

# =============================================================================
# Access control
# =============================================================================

# The single seeded account, created/rotated by `php artisan app:ensure-admin`.
# Idempotent on ADMIN_EMAIL: re-running rotates the password, it never creates
# a second account. Leave ADMIN_PASSWORD empty and NO account is created — a
# predictable default on a public host is worse than no account at all.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME="Admin"
# Minimum 12 characters. Unset = no account created.
ADMIN_PASSWORD=

# --- Rate limits (requests per minute) ---------------------------------------
# Sized per route against real traffic shape, not one blanket number.
# STATUS is deliberately generous: the UI polls every 2.5s = 24 req/min PER TAB,
# so a 60/min shared limit would break the live status view with 3 tabs open.
THROTTLE_LOGIN_PER_MINUTE=5
THROTTLE_LOGIN_IP_PER_MINUTE=30
THROTTLE_UPLOAD_PER_MINUTE=20
THROTTLE_STATUS_PER_MINUTE=120
THROTTLE_DEFAULT_PER_MINUTE=60
